<?php
/**
 * TEMPLATE — copy this file to  api/pcm-quickbooks.php  (which is gitignored)
 * and fill in the real values. NEVER commit pcm-quickbooks.php — it holds your
 * API secret. All values come from your free Intuit Developer app + your
 * QuickBooks company. See quickbooks-phase2-setup.txt for the step-by-step.
 */

// --- From developer.intuit.com -> your app -> Keys & credentials -----------
$QBO_CLIENT_ID     = '';        // app Client ID
$QBO_CLIENT_SECRET = '';        // app Client Secret  (SECRET — server only)

// --- Your QuickBooks company (realm) id ------------------------------------
$QBO_REALM_ID      = '';        // shown when you authorise (and in the OAuth Playground)

// 'sandbox' while testing against a free test company; 'production' for the real books
$QBO_ENV           = 'sandbox';

// --- A long random string YOU invent: the ?k= guard for running over HTTP --
$QBO_GUARD         = '';        // e.g. run once:  php -r "echo bin2hex(random_bytes(16));"

// --- The QuickBooks Product/Service item every invoice line points at ------
// Create ONE service item in QBO (Gear > Products and services > New > Service),
// then read its Id from the staff portal's "List QuickBooks items" button.
// ⚠ NOT from the browser address bar (that trick is the CUSTOMER page, not items)
// and NOT the SKU — the SKU is a different, company-defined field.
$QBO_ITEM_ID       = '';

// --- VAT: read this before your first live invoice --------------------------
// ⚠ Leaving this blank is NOT the same as charging no VAT. Intuit UK cannot turn
// the VAT centre off once it has been set up (only default it to "No VAT"), and
// outside the US a line with a BLANK tax code is treated as TAXABLE, not exempt.
// So if VAT is enabled in your QuickBooks company, put the Id of its ACTIVE
// "No VAT" tax code here. The staff portal's "Check setup" tells you whether VAT
// is on in your company and lists the candidate codes with their Ids.
// Per-company: this Id differs between a sandbox and your real books.
// Confirm the choice with your accountant — it decides what your books say.
$QBO_TAX_CODE_ID   = '';        // e.g. the Id of "No VAT"; blank only if VAT was never enabled

// --- SAFETY GATES (leave these until you've tested — see the setup guide) ---
// NB this one gate covers BOTH writers: the monthly run (pcm-invoice.php) and the
// "Invoice in QuickBooks" button on the staff diary's contact card (pcm-qbo.php).
// While it is false that button still works — it reports what it WOULD do and
// writes nothing, which is the intended way to try it.
$QBO_LIVE_ENABLED  = false;     // must be true AND the call must use live=1 before ANY real invoice is created
$QBO_ONLY_KEY      = '';        // set to ONE licence key (e.g. 'ABCD-EFGH-JKLM') to invoice just that customer first
