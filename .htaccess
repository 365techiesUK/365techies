# ============================================================
# 365 Techies — .htaccess (Apache). Place in the web root.
# Handles: HTTPS + non-www canonical, custom 404, 301 redirects
# from the old WordPress URLs, gzip compression and caching.
# ============================================================

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# --- Force non-www, then HTTPS (loop-safe behind SiteGround/Cloudflare) ---
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://365techies.co.uk%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://365techies.co.uk%{REQUEST_URI} [L,R=301]

# --- Old WordPress AMP URLs (/slug/amp/ or ?amp) -> canonical non-AMP page ---
# The new static site has no AMP. Strip the AMP path-suffix or query param so old
# AMP pages still in Google's index resolve to the real page (then through the
# redirects below) instead of dead-ending on the 404. Runs before the redirect map.
RewriteRule ^(.+?)/amp/?$ /$1/ [R=301,L,NC]
RewriteCond %{QUERY_STRING} (^|&)amp(=[^&]*)?(&|$) [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]

# --- 410 Gone: dead WordPress / WooCommerce / BuddyPress system pages ---
# NB: "activate" removed from this Gone list - /activate/ is now the live PC Manager activation page
RewriteRule ^(members|members-2|activity|activity-2|groups|forums|register|register-2|profile|moderation|messages|notifications|videos|documents|photos|password-reset|password-recover|external-link|sidebar|gutenberg|remote-jobs|365live|my-account|my-account-2|cart|checkout|checkout-2|shop-2)/?$ - [G]
RewriteRule ^shop/?$ /dell-hardware/ [R=301,L]

# --- AI estate consolidation (2026-08-10) ---
# Two intents each had TWO live self-canonical pages (legacy top-level + the
# /ai/ estate), splitting link equity — the audit found the legacy pages
# outranking the new hub. One URL per intent: the /ai/ estate wins.
RewriteRule ^ai-voice-agents/?$ /ai/voice-agents/ [R=301,L]
RewriteRule ^ai-training/?$ /ai/training/ [R=301,L]
# 2026-08-31, post-freeze baseline review: the last true duplicate pair.
# /agentic-ai-systems/ and /ai/agents/ were both live, both self-canonical and
# both in the sitemap for the same intent; the legacy page held 292 impressions
# at position 35.5 and ZERO clicks over 90 days while the newer page went
# unindexed. One URL per intent — the /ai/ estate wins. Keep >= 1 year.
#
# ⚠️ The other manifest rows are NOT here on purpose. /365-ai-os/,
# /ai-for-beginners-course/, /ai-roi-calculator/ and /using-ai-safely/ were to
# be redirected to /ai/tools/... and /ai/learn/... children that WERE NEVER
# BUILT — those URLs 404 today. Redirecting live pages into 404s would have
# destroyed /ai-for-beginners-course/, the only legacy AI page earning clicks.
# Build the targets first, or leave these alone.
RewriteRule ^agentic-ai-systems/?$ /ai/agents/ [R=301,L]

# Short, sayable URLs for the review ask - "just go to 365techies.co.uk/review".
# The team says these on the phone and they are printed on the referral cards,
# so they must never break.
RewriteRule ^review/?$   /leave-a-review/ [R=301,L]
RewriteRule ^reviewus/?$ /leave-a-review/ [R=301,L]
# /ai is a real page now (the AI & Automation hub) - the temporary shortcut
# redirect to /365-ai-os/ was removed at launch (2026-08-08). Do not re-add:
# a rewrite here shadows the hub's own index.html.

# /sos/ is now a real on-site page (built by build_extra.py sos_page) with the
# Splashtop direct-download links embedded - no redirect needed.


# ============================================================
# 301 REDIRECTS — old WordPress pages -> new pages
# ============================================================

# --- Company / core ---
RewriteRule ^about-us/?$                                      /about/ [R=301,L]
RewriteRule ^terms-of-service/?$                              /terms/ [R=301,L]
RewriteRule ^privacy/?$                                       /privacy-policy/ [R=301,L]
RewriteRule ^f-?a-?q/?$                                       /faqs/ [R=301,L]
RewriteRule ^(prices|products)/?$                             /pricing/ [R=301,L]
RewriteRule ^services-2/?$                                    /services/ [R=301,L]
RewriteRule ^book-now/?$                                      /book-service/ [R=301,L]

# --- Old WordPress structural leftovers (found 29 Jul 2026) ---
# These two still 404 and were hiding in "Crawled - currently not indexed" rather
# than in the 404 report, so the coverage summary alone would never have surfaced
# them. Both have an obvious successor, so a 301 beats a 404.
# Wildcard on /category/ - tech was simply the one Google happened to remember,
# and any other old category archive should land in the same place.
RewriteRule ^category(/.*)?$                                  /it-advice/ [R=301,L]
RewriteRule ^bournemouthlive(/.*)?$                           /contact/ [R=301,L]

# --- Home / support ---
# /home/ was the old WordPress homepage alias. It was the ONLY genuine 404 in the
# Search Console coverage report on 29 Jul 2026 - reported four times, once for each
# protocol/www combination. Must sit ABOVE the home-computer-* rule below, or the
# alternation there would never see it. Goes to the root, not a support page.
RewriteRule ^home/?$                                          / [R=301,L]
RewriteRule ^(support|home-computer-support|home-computer-servicing-and-support)/?$ /home-it-support-subscriptions/ [R=301,L]
RewriteRule ^computer-support-bournemouth/?$                  /it-support-bournemouth/ [R=301,L]
RewriteRule ^it-support-near-me-computer-repair-support-and-servicing/?$ /it-support-dorset/ [R=301,L]
RewriteRule ^(365-pc-manager|pc-manager)/?$ /free-pc-health-check/ [R=301,L]

# --- Repairs ---
RewriteRule ^(computer-repair|repairs|computer-help-near-me|computer-repair-near-me-service-support)/?$ /computer-repairs/ [R=301,L]

# --- Specific service pages ---
RewriteRule ^(windows-11-upgrades-dell-bournemouth|windows-11-upgrade-dell|how-to-upgrade-to-windows-11-without-waiting-in-line)/?$ /windows-11-support/ [R=301,L]
RewriteRule ^(email-hosting|website-email-hosting)/?$        /web-design-hosting/ [R=301,L]
RewriteRule ^microsoft-office-support/?$                      /microsoft-365-support/ [R=301,L]

# --- Town pages: old "computer-repair-near-me-service-support-TOWN" -> new computer-repair-TOWN ---
RewriteRule ^computer-repair-near-me-service-support-(beaminster|blandford-forum|boscombe|bournemouth|bridport|canford-heath|christchurch|corfe-mullen|dorchester|ferndown|gillingham|lyme-regis|poole|portland|shaftesbury|sherborne|st-ives|sturminster-newton|swanage|upton|verwood|wareham|west-moors|west-parley|weymouth|wool|wyke-regis)/?$ /computer-repair-$1/ [R=301,L]
RewriteRule ^computer-repair-near-me-service-support-wimborne-minster/?$ /computer-repair-wimborne/ [R=301,L]
# Any other old town / doorway page (villages without a page + non-Dorset junk) -> Areas Covered
RewriteRule ^computer-repair-near-me                          /areas-covered/ [R=301,L]

# --- Blog / articles -> nearest new page ---
RewriteRule ^blog/?$                                          /it-advice/ [R=301,L]
# 2026-08-18: the short children-online blog post is superseded by the parents' guide hub
RewriteRule ^how-to-keep-children-safe-online/?$              /parents-guide-online-safety/ [R=301,L]
RewriteRule ^top-20-advantages-of-remote-computer-support/?$ /remote-it-support/ [R=301,L]
RewriteRule ^avoid-temptation-to-turn-off-your-wifi-at-night-to-try-and-save-on-energy-bills/?$ /wifi-support/ [R=301,L]
RewriteRule ^impacts-of-remote-work/?$                        /it-support-for-home-workers/ [R=301,L]
RewriteRule ^stolen-laptop-recovered/?$                       /lost-or-stolen-laptop-what-to-do/ [R=301,L]
RewriteRule ^(7-reasons-to-buy-a-refurbished-laptop|refurbishing-a-laptop)/?$ /are-refurbished-laptops-any-good/ [R=301,L]
RewriteRule ^ten-side-hustle-ideas-to-help-you-make-some-extra-cash/?$ /it-advice/ [R=301,L]

# --- Old WordPress sitemaps -> new sitemap ---
RewriteRule ^(sitemap_index\.xml|page-sitemap\.xml|post-sitemap\.xml|wp-sitemap\.xml)$ /sitemap.xml [R=301,L]

# ============================================================
# Custom 404
# ============================================================
ErrorDocument 404 /404.html

# ============================================================
# Don't serve the FTP deploy state file or any stray source files
# ============================================================
<FilesMatch "(\.ftp-deploy-sync-state\.json|\.py|\.toml|\.ya?ml)$">
  Require all denied
</FilesMatch>
# Belt-and-braces: never serve the VRM token file over HTTP (PHP include reads it from disk)
<Files "vrm-token.php">
  Require all denied
</Files>
# Never compress/buffer the realtime SSE stream
<Files "vrm-live.php">
  SetEnv no-gzip 1
</Files>
# Never serve the Slack webhook config or rate file over HTTP
<Files "slack-webhook.php">
  Require all denied
</Files>
# Second webhook (the #daily-jobs-in-jobs-out "Quote agreed" cards) and the job
# store behind it: names, numbers and amounts. pcm-jobs.php itself stays served.
<Files "slack-webhook-jobs.php">
  Require all denied
</Files>
<FilesMatch "^pcm-jobs\.(json(\..*)?|log)$">
  Require all denied
</FilesMatch>
# Plan-invite endpoint keeps a log (customer emails + which plan) and an optional
# owner plan-override file. pcm-invite.php itself stays served.
<FilesMatch "^pcm-invite\.log$">
  Require all denied
</FilesMatch>
<FilesMatch "^pcm-invite-plans\.json$">
  Require all denied
</FilesMatch>
<FilesMatch "^pcm-invite-allow\.json(\..*)?$">
  Require all denied
</FilesMatch>
<FilesMatch "^pcm-gc-live\.json(\..*)?$">
  Require all denied
</FilesMatch>
<FilesMatch "^pcm-gc-templates\.json(\..*)?$">
  Require all denied
</FilesMatch>
<Files "slack-rate.json">
  Require all denied
</Files>
# Textmagic SMS: the API key file, its rate counter and its send log.
# tm-lib.php is a library (never a URL) so it is denied too; tm-send.php stays
# served because staff call it, and it gates on an admin session of its own.
<FilesMatch "^(tm-key|tm-lib)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^(tm-rate|tm-log|tm-sched|tm-beat)\.json(\..*)?$">
  Require all denied
</FilesMatch>
<Files "tm-cron.lock">
  Require all denied
</Files>
<FilesMatch "^(tools-rate|domain-cache|isitdown-cache|wifi-map-rate|wifi-map-pins)\.json(\.tmp|\.lock)?$">
  Require all denied
</FilesMatch>
# Street Manager roadworks: the Cloudflare Worker read token is a credential,
# and the polled cache + rate counter are internal. street-manager.php itself
# stays served - it is the public read endpoint the map calls, and holds no key.
<FilesMatch "^(street-manager-key\.php|street-manager-(cache|rate)\.json(\.tmp|\.lock)?)$">
  Require all denied
</FilesMatch>
# Bournemouth365 Portal: provider keys are a credential; the caches, rate
# counters and the OAuth token file are internal state. The library files are
# include-only and never a URL. The dorset-buses/-roads/-satellite/-floods/
# -water endpoints themselves stay served - they are the public read side and
# hold no key.
<FilesMatch "^(dorset-keys\.php|dorset-(lib|datex-lib)\.php|dorset-[a-z-]+-(cache|rate|token|readings|budget)\.json(\..*)?|dorset-[a-z-]+\.lock|dorset-satellite\.jpg|.*\.pbf)$">
  Require all denied
</FilesMatch>
# AI opportunity pipeline (blueprint doc 06): the store holds enquiry PII and
# must never be served; the lib is include-only; the rate counter is internal.
# ai-lead.php itself stays served - it is the public intake endpoint.
<FilesMatch "^(ai-pipeline\.json(\..*)?|ai-lead-rate\.json|ai-lead-lib\.php)$">
  Require all denied
</FilesMatch>
# Comms hub: the inbox store holds message bodies + full numbers, the IMAP
# config is a credential, and voicemail audio is customer voice - all denied.
# Audio is streamed ONLY through the staff-authed comms.php console.
<FilesMatch "^(comms-data\.json(\..*)?|comms-lib\.php|vm-imap\.php|vm-audio-[A-Za-z0-9\-]+\.(mp3|wav))$">
  Require all denied
</FilesMatch>
# Live-visitors: the Worker read token is a credential; the cache is internal.
# visitors.php itself stays served - it authenticates per request.
<FilesMatch "^(visitors-key\.php|visitors-cache\.json(\..*)?)$">
  Require all denied
</FilesMatch>
# Signal map + van telemetry stores. THESE WERE PUBLICLY READABLE UNTIL 2026-09-01
# (signal-data.json alone was 797 KB) - the same class of miss as pcm-bkpoll-cache
# above, and for the same reason: every one of these files is generated at RUNTIME
# and gitignored, so it never appears in the repo and never prompts a rule.
#
# Why it mattered here rather than being merely untidy: signal-log.php applies the
# one-hour privacy embargo (EMBARGO_S) and the retroactive geo-fence strip AT READ
# TIME, as it serves. These files are the store BEHIND that filter, so fetching one
# directly returned the unfiltered set - van positions inside the embargo window and
# the location history the fence exists to hide. signal-check-data.json likewise
# bypassed MIN_FOR_COMPARE, which is the guard that keeps per-operator readings from
# becoming the league table we do not publish.
#
# The endpoints stay served - only the stores are denied. signal-token.php,
# geo-fence.php and pcm-team-lib.php are @include-only, so denying them over HTTP
# costs nothing: .htaccess gates requests, not include().
<FilesMatch "^(signal-(data|geo)\.json(\..*)?|signal-check-(data|rate)\.json(\..*)?|signal-token\.php|geo-fence\.php|van-live-(data|geo)\.json(\..*)?|pcm-team-lib\.php)$">
  Require all denied
</FilesMatch>
# Victron VRM caches, the Venus device CA, and the broadband comparison store.
# Same 2026-09-01 sweep. vrm-live.php / vrm-history.php / broadband-compare.php
# stay served - they are the public read side and hold no credential.
<FilesMatch "^(vrm-(cache|history-cache|weather-cache)\.json(\..*)?|venus-ca\.crt|broadband-compare-(data|rate)\.json(\..*)?)$">
  Require all denied
</FilesMatch>
# The Overpass road-geometry cache: files are sha1(query).json inside
# api/dorset-overpass-cache/, so the dorset-*-cache rule above cannot match them.
# A directory block is not available in .htaccess and the directory is created at
# runtime, so match the filename shape instead.
<FilesMatch "^[a-f0-9]{40}\.json$">
  Require all denied
</FilesMatch>
# 365 PC Manager broadband speed test payload (downloads/speedtest/*.bin): random bytes,
# so no compression, and NEVER cached - a cached payload measures the proxy, not the line.
# Explicitly public: it must be fetchable by every customer PC. Added 2026-08-18.
<FilesMatch "^[0-9]+mb\.bin$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Content-Type "application/octet-stream"
  SetEnv no-gzip 1
  SetEnv no-brotli 1
</FilesMatch>
# 365 PC Manager + Service Pass server-only data/secret files - NEVER serve over HTTP.
# (The endpoints pcm.php, pcm-admin.php, pcm-sb-callback.php, pass.php stay served - not matched here.)
# NB pcm-bkpoll-cache.json holds a LIVE SimplyBook admin token (found publicly
# readable 2026-07-27 - it was never in this list). Any new *-cache/token file the
# api/ writes MUST be added here; check with a browser fetch, not curl (the bot wall
# answers 202 to scripted requests and hides a real 200).
<FilesMatch "^(pcm-data|pcm-sb-token|pcm-bkpoll-cache|pcm-used|pass-used|pcm-throttle|pcm-joincodes|pcm-waitlist|pcm-waitlist-rate|pcm-fb-rate|pcm-reviewq|pcm-pubrate|pcm-draftfb|pcm-draftfb-rate|pcm-bkpend|pcm-bkpend-beat|bm-sea-cache|bm-sea-beat|pcm-wifi-[a-f0-9]+|pcm-bb-[a-f0-9]+|pcm-msg-[a-f0-9]+|pcm-msg-beat)\.json(\..*)?$">
  Require all denied
</FilesMatch>
# Portal messaging: the Slack BOT token (the only bot token in the project), the
# per-install filename salt, the CLI-only cron, and the shared libraries. The
# cron also refuses non-CLI itself - this is the belt to that braces, because a
# lost .htaccess has happened here before.
<FilesMatch "^(pcm-slack-bot|pcm-msg-salt|pcm-slack-lib|pcm-msg-lib|pcm-msg-poll|pcm-bkpend-lib|pcm-bkpend-test|pcm-rvbf-test|bm-sea-lib|bm-sea-key)\.php$">
  Require all denied
</FilesMatch>
<Files "pcm-msg-cron.lock">
  Require all denied
</Files>
<Files "pcm-smtp.php">
  Require all denied
</Files>
# SOS screenshots are viewed only through the authed admin console, never served directly
<FilesMatch "^pcm-sos-[a-f0-9\-]+\.jpg$">
  Require all denied
</FilesMatch>
# portal report copies are served only through the wtoken-authed reportget action
<FilesMatch "^pcm-rep-[a-f0-9\-]+\.html$">
  Require all denied
</FilesMatch>
# diagnostics bundles (collectlogs) are served only through the staff-authed stafflog action
<FilesMatch "^pcm-log-[a-f0-9\-]+\.txt$">
  Require all denied
</FilesMatch>
<FilesMatch "^(pcm-admin-secret|pcm-simplybook|pcm-textmagic|pass-secret|pcm-gocardless|pcm-feeds-keys|pcm-quickbooks)\.php$">
  Require all denied
</FilesMatch>
# QuickBooks. pcm-qbo-token.json holds a LIVE Intuit OAuth refresh token - the
# same class of miss as pcm-bkpoll-cache.json above, and it was never listed
# either. pcm-invoice-state.json maps customer emails to QuickBooks ids, and the
# log names customers and amounts. The endpoints pcm-invoice.php and pcm-qbo.php
# stay served; only their data does not. Note the (\..*)? tail - the writers use
# tmp+rename with the pid in the name, so a crash can leave a .12345.tmp behind.
<FilesMatch "^(pcm-qbo-token|pcm-invoice-state)\.json(\..*)?$">
  Require all denied
</FilesMatch>
<FilesMatch "^pcm-invoice\.(log|lock)$">
  Require all denied
</FilesMatch>
# Coast & sky feed caches. The space-weather ones are public domain, but the tide
# and weather ones are our licensed copies of Admiralty/Met Office data - served
# only through pcm-feeds.php, never raw.
<FilesMatch "^pcm-feed-[a-z0-9_\-]+\.json(\..*)?$">
  Require all denied
</FilesMatch>
<Files "pcm-gc-cache.json">
  Require all denied
</Files>
# The Service Pass payload is delivered only through the token gate (pass.php), never directly.
# app auto-update manifest must never be cache-served stale
<Files "version.json">
  Header set Cache-Control "no-store"
</Files>
<FilesMatch "\.ps1$">
  Require all denied
</FilesMatch>

# ============================================================
# MIME types Apache does not know by default
# ============================================================
# .webmanifest was being served as text/html, which is wrong and which some
# browsers reject outright. Note the manifest deliberately declares
# "display": "browser" - that is what stops phones offering to INSTALL the
# marketing site as an app. It was "standalone", and the owner hit the prompt
# on his own site and assumed a third party was installing something; a
# customer would read it far less charitably. There is no service worker, so
# an installed copy would have had no address bar, no back button and no
# offline page - strictly worse than a tab. The manifest still earns its keep
# for the mobile theme colour and the icon/name on a deliberate bookmark.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# ============================================================
# Performance: compression (Brotli preferred, gzip fallback)
# ============================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ============================================================
# Performance: browser caching
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  # ⚠ STANDING RULES (researched + live-verified 2026-07-27):
  # 1. These Cache-Control headers are the ONLY thing keeping HTML out of SiteGround's
  #    NGINX Dynamic Cache (12h TTL). FTPS deploys do NOT purge it and there is no
  #    purge API for non-WordPress sites - if HTML ever loses no-cache here, every
  #    page can be served 12 hours stale with no way to flush from CI.
  # 2. Never enable SiteGround CDN casually: even its free tier caches static HTML at
  #    edge locations for 12h, with a separate manual purge.
  # App-like pages (sign-in flows) must NEVER be cache-served stale - a customer on an old
  # portal page mid-fix is undebuggable ("nowhere to enter the code").
  SetEnvIf Request_URI "^/(portal|family|activate)/" PCMNOSTORE
  # Versioned assets (?v=) are safe to cache forever
  <FilesMatch "\.(css|js|svg|jpe?g|png|ico|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must always revalidate so updates show immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
    # The no-store override MUST live inside this FilesMatch: Apache merges <Files*>
    # sections AFTER body-level directives, so a body-level "Header set" here is
    # silently beaten by the no-cache above no matter where it sits in the file.
    # (Verified live 2026-07-27: the body-level form served plain no-cache.)
    Header set Cache-Control "no-store, max-age=0" env=PCMNOSTORE
  </FilesMatch>
  # ⚠ 3. UN-VERSIONED DATA/TEXT FILES MUST REVALIDATE. Found live 2026-08-01:
  #    /site.webmanifest was being served from SiteGround's proxy cache with a
  #    Last-Modified of 28 JUNE - over a month stale - because it carried NO
  #    Cache-Control at all. The same query with a ?bust= returned MISS and the
  #    correct current file, which is the proof. The rules above only cover the
  #    versioned assets (?v=) and .html; everything else silently inherited the
  #    proxy default and stuck. That included sitemap.xml, robots.txt and
  #    llms.txt - files GOOGLE fetches, where a month of staleness is an SEO
  #    problem nobody would ever have thought to look for.
  #    no-cache, not no-store: these still revalidate cheaply with a 304.
  #    MUST sit above the build-id.json <Files> block - Apache merges <Files>
  #    and <FilesMatch> in source order, so build-id keeps its stricter no-store.
  <FilesMatch "\.(webmanifest|json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The portal's freshness beacon - must never be cached anywhere
  <Files "build-id.json">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>
